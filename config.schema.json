{
  "pluginAlias": "XiaomiRoborockVacuum",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "customUiPath": "./dist/homebridge-ui",
  "headerDisplay": "Add one entry per vacuum cleaner. Existing `accessories` configs keep working, but only the platform format can be edited here: if your vacuum is under `accessories` in config.json, move it to `platforms` (and rename `\"accessory\"` to `\"platform\"`) before editing it here.",
  "schema": {
    "type": "object",
    "properties": {
      "devices": {
        "title": "Vacuum cleaners",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "default": "Xiaomi Mi Robot Vaccum 1st Generation",
              "minLength": 1,
              "required": true
            },
            "ip": {
              "title": "IP",
              "type": "string",
              "description": "Optional with the `did` (the platform's `cloud` option): it's read from your Xiaomi account."
            },
            "token": {
              "title": "Token",
              "type": "string",
              "description": "Optional with the Xiaomi Cloud (the platform's `cloud` option): it's read from your Xiaomi account."
            },
            "did": {
              "title": "Device ID (Xiaomi Cloud)",
              "type": "string",
              "description": "Instead of the IP and token, with the platform's `cloud` option: they're read from your Xiaomi account, and found again if they change (e.g. a new IP from the router). It's in the logs, and in `npx node-miio cloud devices`."
            },
            "serviceType": {
              "title": "How the vacuum shows up in HomeKit",
              "type": "string",
              "default": "fan",
              "oneOf": [
                { "title": "Fan (on/off + fan speed)", "enum": ["fan"] },
                { "title": "Switch (on/off only)", "enum": ["switch"] },
                {
                  "title": "Robot vacuum (Matter, iOS 18.4+)",
                  "enum": ["vacuum"]
                }
              ],
              "required": false,
              "description": "Robot vacuum: Apple Home's native vacuum, with its rooms and clean modes. It needs Matter enabled in the bridge that runs this plugin, and is paired separately, with its own code (see the README)."
            },
            "waterBox": {
              "title": "Enable the Water Box mode (beta)",
              "type": "boolean",
              "required": false,
              "description": "Leave it unset to enable it automatically on the models that support it (platform only)."
            },
            "dustBin": {
              "title": "Enable the Dust Bin indicator (beta)",
              "type": "boolean",
              "default": false,
              "required": false
            },
            "dustCollection": {
              "title": "Enable the Dust Collection mode (beta)",
              "type": "boolean",
              "default": false,
              "required": false
            },
            "mopWash": {
              "title": "Show a switch to wash the mop (docks with mop washing only)",
              "type": "boolean",
              "default": false,
              "required": false
            },
            "mopDrying": {
              "title": "Show a switch to dry the mop (docks with a mop dryer only)",
              "type": "boolean",
              "default": false,
              "required": false
            },
            "waterTankEmpty": {
              "title": "Show a sensor for \"water tank empty\" (only models that report it, usually with a self-refilling dock)",
              "type": "boolean",
              "default": false,
              "required": false
            },
            "disableCareServices": {
              "title": "Disable Care Services",
              "type": "boolean",
              "default": false,
              "required": false
            },
            "debug": {
              "title": "Show debug logs (use it when reporting an issue), without enabling Homebridge's debug mode",
              "type": "boolean",
              "default": false,
              "required": false
            },
            "silent": {
              "title": "Do not log info and debug messages (only log warn and error messages)",
              "type": "boolean",
              "default": false,
              "required": false
            },
            "pause": {
              "title": "Show switch for \"pause\"",
              "type": "boolean",
              "default": false,
              "required": true
            },
            "pauseWord": {
              "title": "Pause Word",
              "type": "string",
              "default": "pause",
              "required": true,
              "condition": {
                "functionBody": "return model.pause === true"
              }
            },
            "findMe": {
              "title": "Show switch for \"find me\"",
              "type": "boolean",
              "default": false,
              "required": true
            },
            "findMeWord": {
              "title": "Find Me Word",
              "type": "string",
              "default": "where are you",
              "required": true,
              "condition": {
                "functionBody": "return model.findMe === true"
              }
            },
            "goTo": {
              "title": "Show switch for \"go to\"",
              "type": "boolean",
              "default": false,
              "required": true
            },
            "goToWord": {
              "title": "Go To Word",
              "type": "string",
              "default": "go to coordinates",
              "required": true,
              "condition": {
                "functionBody": "return model.goTo === true"
              }
            },
            "goToX": {
              "title": "x-coordinate",
              "type": "integer",
              "default": 25500,
              "required": true,
              "condition": {
                "functionBody": "return model.goTo === true"
              }
            },
            "goToY": {
              "title": "y-coordinate",
              "type": "integer",
              "default": 25500,
              "required": true,
              "condition": {
                "functionBody": "return model.goTo === true"
              }
            },
            "goToSpots": {
              "title": "\"Go to\" spots",
              "type": "array",
              "description": "A \"go to …\" switch per spot: on sends the robot there, off sends it back to the dock. Pick them on the map above (Roborock), or find the coordinates with the \"find me\" switch and the Xiaomi Cloud.",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "title": "Name",
                    "type": "string",
                    "required": true
                  },
                  "x": {
                    "title": "x",
                    "type": "integer",
                    "required": true
                  },
                  "y": {
                    "title": "y",
                    "type": "integer",
                    "required": true
                  }
                }
              }
            },
            "goToSpotWord": {
              "title": "\"Go to\" spots word",
              "type": "string",
              "default": "go to",
              "description": "The first word(s) of the spots' switches, in your language: \"go to Kitchen door\".",
              "condition": {
                "functionBody": "var spots = model.devices[arrayIndices].goToSpots; return !!spots && spots.length > 0;"
              }
            },
            "goToDock": {
              "title": "Show switch for \"go to dock\"",
              "type": "boolean",
              "default": false,
              "required": false
            },
            "goToDockWord": {
              "title": "Go To Dock Word",
              "type": "string",
              "default": "go to dock",
              "required": false,
              "condition": {
                "functionBody": "return model.devices[arrayIndices].goToDock === true;"
              }
            },
            "dock": {
              "title": "Show Dock sensor",
              "type": "boolean",
              "default": true,
              "required": true
            },
            "roomSensors": {
              "title": "Show a sensor per room, detected while the robot is in it (Roborock, needs the Xiaomi Cloud option below)",
              "type": "boolean",
              "default": false
            },
            "cleanword": {
              "title": "Cleaning Word",
              "type": "string",
              "default": "cleaning",
              "required": true
            },
            "roomTimeout": {
              "title": "Room autoclean timeout",
              "type": "integer",
              "default": 0,
              "required": false
            },
            "autoroom": {
              "title": "Automatic Room Detection",
              "type": "boolean",
              "default": false,
              "required": false
            },
            "rooms": {
              "title": "Room cleaning",
              "type": "array",
              "required": false,
              "items": {
                "title": "Rooms",
                "type": "object",
                "properties": {
                  "name": {
                    "name": "Room Name",
                    "type": "string"
                  },
                  "id": {
                    "name": "Room ID",
                    "type": "integer"
                  },
                  "repeats": {
                    "title": "Also clean it",
                    "type": "array",
                    "uniqueItems": true,
                    "description": "Extra switches to clean the room 2 or 3 times (\"Kitchen 2x\"). The robot takes one count for the whole run: with several rooms selected, the highest wins.",
                    "items": {
                      "type": "integer",
                      "enum": [2, 3]
                    }
                  }
                }
              }
            },
            "zones": {
              "title": "Zone cleaning",
              "type": "array",
              "required": false,
              "items": {
                "title": "Zones",
                "type": "object",
                "properties": {
                  "name": {
                    "name": "Name",
                    "type": "string",
                    "required": true
                  },
                  "zone": {
                    "name": "Zone's Coordinates",
                    "required": true,
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "title": "Coordinates (Bottom-Left X, Bottom-Left Y, Top-Right X, Top-Right Y, # Repeats)",
                      "type": "array",
                      "minItems": 5,
                      "maxItems": 5,
                      "items": {
                        "type": "number",
                        "required": true
                      }
                    }
                  },
                  "speed": {
                    "title": "Fan speed",
                    "description": "Set before cleaning the zone, e.g. Quiet, Balanced, Turbo, Max, or Mop (no suction, S7 and newer). Leave empty to keep the current one.",
                    "type": "string",
                    "required": false
                  },
                  "waterSpeed": {
                    "title": "Water level",
                    "description": "Set before cleaning the zone (needs Water Box): Off, Light, Medium or High. Leave empty to keep the current one.",
                    "type": "string",
                    "required": false
                  }
                }
              }
            }
          },
          "anyOf": [
            {
              "required": ["did"]
            },
            {
              "required": ["ip"]
            }
          ]
        }
      },
      "cloud": {
        "title": "Xiaomi Cloud (optional)",
        "description": "Get the robots' tokens from your Xiaomi account (so only their IP is needed), and know the room the robot is cleaning (and its position, in the logs) by downloading its map while it cleans (Roborock vacuums only). Before enabling it, log in once with `npx node-miio cloud login --qr`, as the same user that runs Homebridge. The session is saved in node-miio's config directory (your password is never stored).",
        "type": "object",
        "properties": {
          "enabled": {
            "title": "Use the Xiaomi Cloud",
            "type": "boolean",
            "default": false
          },
          "sessionFile": {
            "title": "Session file",
            "type": "string",
            "description": "(Optional) The session saved by `npx node-miio cloud login`, if it's not in the default location (e.g. when Homebridge runs as another user)."
          },
          "server": {
            "title": "Server",
            "type": "string",
            "enum": ["cn", "de", "us", "ru", "tw", "sg", "in", "i2"],
            "description": "(Optional) The server your robots are registered in. Found automatically when empty."
          }
        }
      }
    }
  },
  "layout": [
    {
      "key": "devices",
      "type": "array",
      "orderable": false,
      "buttonText": "Add vacuum cleaner",
      "items": [
        {
          "type": "fieldset",
          "title": "{{ value.name || 'Vacuum cleaner' }}",
          "items": [
            "devices[].name",
            {
              "type": "flex",
              "flex-flow": "row wrap",
              "items": ["devices[].ip", "devices[].token", "devices[].did"]
            },
            "devices[].serviceType",
            "devices[].waterBox",
            "devices[].dustBin",
            "devices[].dustCollection",
            "devices[].mopWash",
            "devices[].mopDrying",
            "devices[].waterTankEmpty",
            "devices[].debug",
            "devices[].silent",
            "devices[].pause",
            "devices[].pauseWord",
            "devices[].findMe",
            "devices[].findMeWord",
            "devices[].goTo",
            "devices[].goToWord",
            {
              "type": "flex",
              "flex-flow": "row wrap",
              "items": ["devices[].goToX", "devices[].goToY"]
            },
            {
              "key": "devices[].goToSpots",
              "type": "array",
              "items": [
                {
                  "type": "div",
                  "displayFlex": true,
                  "flex-direction": "row",
                  "items": [
                    {
                      "key": "devices[].goToSpots[].name",
                      "flex": "4 4 200px",
                      "notitle": true,
                      "placeholder": "Name"
                    },
                    {
                      "key": "devices[].goToSpots[].x",
                      "flex": "1 1 80px",
                      "notitle": true,
                      "placeholder": "x"
                    },
                    {
                      "key": "devices[].goToSpots[].y",
                      "flex": "1 1 80px",
                      "notitle": true,
                      "placeholder": "y"
                    }
                  ]
                }
              ]
            },
            "devices[].goToSpotWord",
            "devices[].goToDock",
            "devices[].goToDockWord",
            "devices[].dock",
            "devices[].roomSensors",
            "devices[].cleanword",
            "devices[].roomTimeout",
            "devices[].autoroom",
            {
              "type": "fieldset",
              "title": "Rooms",
              "description": "Room Mapping",
              "expandable": true,
              "expanded": false,
              "items": [
                {
                  "notitle": true,
                  "key": "devices[].rooms",
                  "type": "array",
                  "items": [
                    {
                      "type": "div",
                      "displayFlex": true,
                      "flex-direction": "row",
                      "items": [
                        {
                          "key": "devices[].rooms[].id",
                          "flex": "1 1 50px",
                          "notitle": true,
                          "placeholder": "Room ID"
                        },
                        {
                          "key": "devices[].rooms[].name",
                          "flex": "4 4 200px",
                          "notitle": true,
                          "placeholder": "Room Name"
                        },
                        {
                          "key": "devices[].rooms[].repeats",
                          "flex": "2 2 120px",
                          "notitle": true,
                          "type": "checkboxes",
                          "titleMap": [
                            {
                              "value": 2,
                              "name": "2x"
                            },
                            {
                              "value": 3,
                              "name": "3x"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "fieldset",
              "title": "Zones",
              "description": "Zone cleaning",
              "expandable": true,
              "expanded": false,
              "items": [
                {
                  "notitle": true,
                  "key": "devices[].zones",
                  "type": "array",
                  "items": [
                    {
                      "type": "div",
                      "displayFlex": true,
                      "flex-direction": "row",
                      "items": [
                        {
                          "key": "devices[].zones[].name",
                          "flex": "1 1 100px",
                          "placeholder": "Zone Name"
                        },
                        {
                          "key": "devices[].zones[].zone",
                          "notitle": true,
                          "flex": "4 4 150px",
                          "type": "array",
                          "items": [
                            {
                              "key": "devices[].zones[].zone[]",
                              "type": "array",
                              "displayFlex": true,
                              "flex-direction": "row",
                              "items": [
                                {
                                  "type": "number"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "div",
                      "displayFlex": true,
                      "flex-direction": "row",
                      "items": [
                        {
                          "key": "devices[].zones[].speed",
                          "flex": "1 1 100px",
                          "placeholder": "Keep the current one"
                        },
                        {
                          "key": "devices[].zones[].waterSpeed",
                          "flex": "1 1 100px",
                          "placeholder": "Keep the current one"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Xiaomi Cloud (optional)",
      "description": "Know the room the robot is cleaning (and its position, in the logs) by downloading its map from the Xiaomi Cloud while it cleans. Roborock vacuums only. Before enabling it, log in once with `npx node-miio cloud login --qr`, as the same user that runs Homebridge: the session is saved in node-miio's config directory (your password is never stored).",
      "expandable": true,
      "expanded": false,
      "items": ["cloud.enabled", "cloud.sessionFile", "cloud.server"]
    }
  ]
}
