{
  "name": "homebridge-xiaomi-roborock-vacuum",
  "version": "1.7.3",
  "description": "Homebridge plugin for Xiaomi and Roborock robot vacuums (Mi Home or Roborock app): control them in Apple Home as the native robot vacuum (Matter), a fan, or switches.",
  "license": "MIT",
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "supports-matter",
    "xiaomi",
    "mi robot",
    "vacuum cleaner",
    "roborock s50",
    "roborock s55",
    "roborock s5",
    "roborock s5 max",
    "xiaomi vacuum gen1",
    "xiaomi vacuum gen2",
    "xiaomi vacuum gen3",
    "roborock s6",
    "roborock t6",
    "roborock t4",
    "roborock q5 pro",
    "xiaowa lite c10",
    "xiaowa c10",
    "mi robot 1s"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homebridge-xiaomi-roborock-vacuum/homebridge-xiaomi-roborock-vacuum.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge-xiaomi-roborock-vacuum/homebridge-xiaomi-roborock-vacuum/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/afharo"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/afharo"
    }
  ],
  "homepage": "https://github.com/homebridge-xiaomi-roborock-vacuum/homebridge-xiaomi-roborock-vacuum",
  "bin": {
    "miio-vacuum": "dist/bin/miio-vacuum.js"
  },
  "main": "dist/index.js",
  "engines": {
    "homebridge": "^2.3.0",
    "node": "^22.12.0 || ^24 || ^26"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "rimraf ./dist && tsc && npm run build:ui",
    "build:ui": "node -e \"require('node:fs').cpSync('src/homebridge-ui/public', 'dist/homebridge-ui/public', { recursive: true })\"",
    "prepublishOnly": "npm run build",
    "postpublish": "npm run clean",
    "preversion": "npm run build && npm test",
    "//": "Ideally, 👇 'version' should update the file CHANGELOG.md (replace Next with the current version)",
    "version": "git add .",
    "postversion": "git push && git push --tags",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js",
    "docker": "docker compose -f docker/docker-compose.yml up --build",
    "docs:speeds": "npm run build && node -e \"require('node:fs').writeFileSync('docs/speeds-and-modes.md', require('./dist/docs/speeds_doc').renderSpeedsDoc())\" && prettier --write docs/speeds-and-modes.md"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.3.0",
    "node-miio": "^0.11.1",
    "rxjs": "^7.5.6"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/preset-env": "7.29.14",
    "@babel/preset-typescript": "7.29.7",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "babel-jest": "30.5.2",
    "homebridge": "2.5.0",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "rimraf": "6.1.4",
    "typescript": "7.0.2"
  }
}
